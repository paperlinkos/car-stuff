rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function isStaff() { return signedIn() && request.auth.token.admin == true; }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }
    match /verificationDocuments/{uid}/{allPaths=**} {
      allow read: if isSelf(uid) || isStaff();
      allow write: if isSelf(uid) && request.resource.size < 10 * 1024 * 1024 && request.resource.contentType.matches('application/pdf|image/.*');
      allow delete: if isSelf(uid) || isStaff();
    }
    // Images are private while listings are in review; do not use download
    // URLs as public-document access control. A later public-media workflow
    // must copy only approved images to a separate reviewed path.
    match /vehiclePhotos/{uid}/{listingId}/{allPaths=**} {
      allow read: if isSelf(uid) || isStaff();
      allow write: if isSelf(uid) && request.resource.size < 10 * 1024 * 1024 &&
        request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow delete: if isSelf(uid) || isStaff();
    }
    match /vehicleDocuments/{uid}/{listingId}/{allPaths=**} {
      allow read: if isSelf(uid) || isStaff();
      allow write: if isSelf(uid) && request.resource.size < 10 * 1024 * 1024 &&
        request.resource.contentType.matches('application/pdf|image/(jpeg|png|webp)');
      allow delete: if isSelf(uid) || isStaff();
    }
    match /{allPaths=**} { allow read, write: if false; }
  }
}
